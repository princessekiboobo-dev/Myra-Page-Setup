{
  "buildCommand": "pnpm --dir artifacts/myra-landing run build",
  "outputDirectory": "artifacts/myra-landing/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/download", "destination": "/index.html" },
    { "source": "/thanks", "destination": "/index.html" }
  ]
}
